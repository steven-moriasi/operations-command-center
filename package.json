{
  "name": "operations-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated operations console for automation workflow monitoring and control",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "next build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.1.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.8",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
